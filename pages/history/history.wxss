/* pages/history/history.wxss */
.history-container {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.stats-card {
  background: linear-gradient(135deg, #0052D9 0%, #2F54EB 100%);
  color: #FFFFFF;
  padding: 36rpx 32rpx;
}

.stats-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.1;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

.list-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 32rpx 0 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.list-tip {
  font-size: 22rpx;
  color: #888;
}

.card-timeline {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.timeline-card {
  padding: 32rpx;
}

.tl-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.tl-date {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.tl-day {
  font-size: 44rpx;
  font-weight: 800;
  color: #222;
}

.tl-ym-col {
  display: flex;
  flex-direction: column;
}

.tl-ym {
  font-size: 22rpx;
  color: #555;
}

.tl-week {
  font-size: 20rpx;
  color: #888;
}

.tl-weather {
  background: #F4F5F9;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #555;
}

.tl-mood-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.tl-emoji {
  font-size: 48rpx;
}

.tl-mood-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tl-mood-name {
  font-size: 26rpx;
  font-weight: 700;
}

.tl-quote-summary {
  font-size: 22rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 4rpx;
}

.tl-note-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #444;
  background: #FAFAFC;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tl-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F2F5;
}

.tl-counts {
  display: flex;
  gap: 20rpx;
}

.tl-count-item {
  font-size: 22rpx;
  color: #666;
}

.tl-arrow {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #999;
}

.empty-wrap {
  padding: 80rpx 0;
}
