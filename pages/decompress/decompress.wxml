<!-- pages/decompress/decompress.wxml -->
<view class="decompress-container">
  <!-- TDesign Tabs 选项卡 -->
  <view class="tabs-header">
    <t-tabs value="{{currentTab}}" bind:change="onTabChange" theme="card">
      <t-tab-panel label="🪵 赛博木鱼" value="woodfish" />
      <t-tab-panel label="🫧 捏气泡纸" value="bubble" />
      <t-tab-panel label="🌬️ 呼吸放空" value="breathe" />
    </t-tabs>
  </view>

  <!-- 1. 赛博木鱼模块 -->
  <view wx:if="{{currentTab === 'woodfish'}}" class="tab-content woodfish-content">
    <view class="woodfish-header">
      <view class="count-display">
        <text class="count-label">{{targetType === 'custom' ? '今日暴打解压' : '今日清心敲击'}}</text>
        <text class="count-num {{targetType === 'custom' ? 'strike-num' : ''}}">{{woodFishCount}}</text>
      </view>
      <view class="sound-toggle press-scale" bindtap="toggleVibrate">
        <t-icon name="{{vibrateEnabled ? 'check-circle' : 'close-circle'}}" size="32rpx" color="{{vibrateEnabled ? '#0052D9' : '#999'}}" />
        <text class="toggle-text">触感震动：{{vibrateEnabled ? '开启' : '关闭'}}</text>
      </view>
    </view>

    <!-- 木鱼/暴打 模式工具栏 -->
    <view class="woodfish-mode-bar">
      <view class="mode-tag {{targetType === 'lotus' ? 'active' : ''}}" bindtap="onResetToLotus">
        <text class="tag-icon">🪷</text>
        <text class="tag-text">清心莲花</text>
      </view>
      <view class="mode-tag {{targetType === 'custom' ? 'active' : ''}}" bindtap="onChooseCustomImage">
        <text class="tag-icon">🥊</text>
        <text class="tag-text">{{customImage ? '更换暴打对象' : '上传照片暴打'}}</text>
      </view>
      <view wx:if="{{targetType === 'custom'}}" class="mode-tag-name press-scale" bindtap="openTargetNameDialog">
        <text class="target-name-text">🏷️ {{targetName}}</text>
        <t-icon name="edit" size="24rpx" color="#666" />
      </view>
    </view>

    <!-- 木鱼主体与敲击动效 -->
    <view class="woodfish-stage" bindtap="onHitWoodfish">
      <!-- 锤子动效 -->
      <view class="hammer-wrapper {{isHammerStriking ? 'hitting' : ''}}">
        <text class="hammer-emoji">🔨</text>
      </view>

      <!-- 暴击星光/火花 -->
      <view wx:if="{{isStriking}}" class="spark-burst">
        <text class="spark-icon">{{targetType === 'custom' ? '💥' : '✨'}}</text>
      </view>

      <!-- 浮动文字飘出动效列表 -->
      <block wx:for="{{floatTexts}}" wx:key="id">
        <text 
          class="float-text {{item.isPunch ? 'punch-text' : ''}}" 
          style="left: {{item.x}}rpx; top: {{item.y}}rpx; animation-duration: 0.9s;"
        >
          {{item.text}}
        </text>
      </block>

      <!-- 敲击/暴打主体 -->
      <view 
        class="woodfish-circle press-scale {{isStriking ? 'striking' : ''}} {{targetType === 'custom' ? 'custom-target-circle' : ''}}"
      >
        <!-- 自定义图片模式 -->
        <block wx:if="{{targetType === 'custom' && customImage}}">
          <image class="target-custom-image" src="{{customImage}}" mode="aspectFill" />
          <view class="target-name-badge">
            <text>{{targetName}}</text>
          </view>
          <text class="hit-tip hit-tip-punch">狠狠砸！</text>
        </block>

        <!-- 默认莲花模式 -->
        <block wx:else>
          <text class="woodfish-icon">🪷</text>
          <text class="hit-tip">轻触敲击</text>
        </block>
      </view>
    </view>

    <view class="woodfish-footer-tip">
      <text wx:if="{{targetType === 'custom'}}">打是亲骂是爱，敲碎烦恼、怒气全消！🥊</text>
      <text wx:else>每一次敲击，都是在向烦恼告别</text>
    </view>
  </view>

  <!-- 2. 捏气泡膜模块 -->
  <view wx:if="{{currentTab === 'bubble'}}" class="tab-content bubble-content">
    <view class="bubble-header">
      <view class="bubble-stats">
        <text>已捏爆 <text class="highlight">{{bubblePoppedCount}}</text> 个烦恼泡泡</text>
      </view>
      <view class="reset-bubble-btn press-scale" bindtap="onResetBubbles">
        <t-icon name="refresh" size="28rpx" color="#0052D9" />
        <text>换一张全新气泡纸</text>
      </view>
    </view>

    <!-- 气泡阵列 -->
    <view class="bubble-grid">
      <block wx:for="{{bubbles}}" wx:key="id">
        <view 
          class="bubble-cell press-scale {{item.popped ? 'popped' : ''}}"
          bindtap="onPopBubble"
          data-index="{{index}}"
        >
          <view class="bubble-inner">
            <text wx:if="{{item.popped}}" class="pop-mark">💥</text>
          </view>
        </view>
      </block>
    </view>

    <view class="bubble-footer-tip">
      <text>指尖的噼啪声，是最纯粹的解压白噪音</text>
    </view>
  </view>

  <!-- 3. 呼吸放空模块 -->
  <view wx:if="{{currentTab === 'breathe'}}" class="tab-content breathe-content">
    <view class="breathe-stage">
      <!-- 动态呼吸光环 -->
      <view class="breathe-circle {{breatheState}}">
        <text class="breathe-state-text">{{breatheText}}</text>
        <text class="breathe-timer">{{breatheTimer}}s</text>
      </view>
    </view>

    <view class="breathe-action">
      <t-button 
        theme="{{isBreathing ? 'danger' : 'primary'}}" 
        size="large" 
        shape="round" 
        block
        bindtap="toggleBreathe"
      >
        {{isBreathing ? '停止放空' : '开始 4-7-8 呼吸放松'}}
      </t-button>
    </view>

    <view class="breathe-guide-card card-box">
      <view class="guide-title">4-7-8 呼吸法则</view>
      <view class="guide-steps">
        <view class="step-item">1. 吸气 4 秒：感受新鲜空气注入身体</view>
        <view class="step-item">2. 屏息 7 秒：让身心静止，清空脑海杂念</view>
        <view class="step-item">3. 呼气 8 秒：缓缓将所有焦虑与压力排出</view>
      </view>
    </view>
  </view>

  <t-toast id="t-toast" />

  <!-- 自定义暴打对象昵称弹窗 -->
  <t-dialog
    visible="{{targetNameDialogVisible}}"
    title="设置暴打对象标签"
    confirm-btn="确定"
    cancel-btn="取消"
    bind:confirm="onConfirmTargetName"
    bind:cancel="onCancelTargetName"
  >
    <view slot="content" class="target-name-input-wrap">
      <input
        class="target-name-input"
        value="{{newTargetName}}"
        placeholder="例如：万恶星期一 / 甲方大大 / 烦恼小怪兽"
        maxlength="12"
        bindinput="onTargetNameInput"
      />
    </view>
  </t-dialog>

  <view class="safe-bottom" />
</view>
