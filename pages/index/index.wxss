/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 顶部动态氛围光晕 */
.ambient-glow {
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120%;
  height: 480rpx;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.7;
  z-index: 0;
  transition: all 0.6s ease;
  pointer-events: none;
}

/* 天气感知栏 */
.weather-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  padding: 22rpx 28rpx;
  border-radius: var(--td-radius-large);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  margin-bottom: 32rpx;
  gap: 16rpx;
}

.weather-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 18rpx;
}

.weather-icon-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #F4F7FC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.weather-icon-img {
  width: 60rpx;
  height: 60rpx;
  display: block;
}

.weather-icon {
  font-size: 46rpx;
  line-height: 1;
}

.weather-text-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.weather-row-city {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 10rpx;
  line-height: 1.2;
}

.weather-city-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(0, 82, 217, 0.08);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.weather-city-badge .city-icon {
  font-size: 20rpx;
}

.weather-city-badge .city-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #0052D9;
  white-space: nowrap;
}

.weather-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  flex-shrink: 0;
}

.weather-temp {
  font-size: 26rpx;
  color: #555;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.weather-feels {
  font-size: 20rpx;
  color: #ED7B2F;
  background: rgba(237, 123, 47, 0.12);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
  font-weight: 500;
}

.weather-desc {
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.weather-switch-btn {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #F5F7FA;
}

.switch-tip {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

/* 区域标题 */
.section-header {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #777;
  margin-top: 6rpx;
}

/* 情绪网格选择 */
.mood-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.mood-item {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12rpx);
  border-radius: var(--td-radius-medium);
  padding: 30rpx 16rpx 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 3rpx solid transparent;
  transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 4rpx 18rpx rgba(31, 35, 41, 0.03);
}

.mood-item.active {
  transform: translateY(-6rpx) scale(1.02);
  background: #FFFFFF;
}

.mood-emoji {
  font-size: 58rpx;
  margin-bottom: 12rpx;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.mood-item.active .mood-emoji {
  transform: scale(1.12);
}

.mood-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2F3542;
}

.mood-check-dot {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  box-shadow: 0 0 10rpx rgba(0, 0, 0, 0.2);
}

/* 碎碎念输入区 */
.input-card {
  position: relative;
  z-index: 1;
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.input-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2329;
}

.quote-random-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.03);
}

.quote-preview {
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.quote-symbol {
  font-size: 38rpx;
  line-height: 1;
  color: #888;
  font-family: Georgia, serif;
}

.quote-content {
  font-size: 26rpx;
  line-height: 1.55;
  color: #3A3F4A;
  font-weight: 500;
}

.textarea-wrap {
  margin-bottom: 28rpx;
  border: 1rpx solid #E9EDF3;
  border-radius: 20rpx;
  padding: 16rpx;
  background: #F9FAFC;
  transition: all 0.2s ease;
}

.textarea-wrap:focus-within {
  background: #FFFFFF;
  border-color: #0052D9;
  box-shadow: 0 0 0 4rpx rgba(0, 82, 217, 0.08);
}

.action-btn-row {
  margin-top: 16rpx;
}

/* 生成后的情绪卡片展示区 */
.card-display-section {
  position: relative;
  z-index: 1;
  margin-top: 36rpx;
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.result-title-bar {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-badge {
  display: inline-block;
  background: #E8F3FF;
  color: #0052D9;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
}

.result-sub {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 精美卡片主体 */
.mood-card-preview {
  border-radius: 36rpx;
  padding: 44rpx 38rpx;
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.08), 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  position: relative;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.card-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.card-date-box {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.card-date-day {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  color: #222;
  font-family: 'Helvetica Neue', Arial, sans-serif;
}

.card-date-col {
  display: flex;
  flex-direction: column;
}

.card-date-ym {
  font-size: 24rpx;
  font-weight: 600;
  color: #444;
}

.card-date-week {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

.card-weather-tag {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(10rpx);
  padding: 10rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}

.card-mood-focus {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.card-mood-emoji {
  font-size: 80rpx;
}

.card-mood-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-mood-tagline {
  font-size: 24rpx;
  color: #555;
  margin-top: 6rpx;
}

.card-quote-box {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8rpx);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-quote-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2c2c2c;
  font-weight: 500;
}

.card-note-box {
  background: rgba(255, 255, 255, 0.55);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 28rpx;
}

.card-note-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.card-note-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #333;
}

.card-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(0, 0, 0, 0.1);
}

.card-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-author-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #444;
}

.card-logo-tag {
  font-size: 20rpx;
  color: #777;
  letter-spacing: 1rpx;
}

/* 操作功能四宫格 */
.card-actions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-btn-item {
  background: #FFFFFF;
  border-radius: var(--td-radius-large);
  padding: 30rpx 20rpx 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.04);
  border: 1rpx solid rgba(240, 243, 248, 0.9);
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.action-btn-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.03);
}

/* 清除 button 默认样式 */
.share-btn {
  margin: 0;
  line-height: normal;
  border: none;
  outline: none;
}
.share-btn::after {
  border: none;
}

.action-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  transition: transform 0.2s ease;
}

.action-btn-item:active .action-icon-wrap {
  transform: scale(0.92);
}

.action-btn-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2329;
}

.action-btn-sub {
  font-size: 20rpx;
  color: #8F959E;
  margin-top: 6rpx;
}

/* 天气选择器弹窗 */
.weather-picker-panel {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 60rpx;
  max-height: 70vh;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.weather-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.weather-option {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #F8F9FB;
  border: 2rpx solid transparent;
}

.weather-option.active {
  background: #ECF2FE;
  border-color: #0052D9;
}

.opt-emoji {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.opt-info {
  flex: 1;
}

.opt-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.opt-desc {
  font-size: 22rpx;
  color: #777;
  margin-top: 4rpx;
}

.hidden-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 900px;
}

/* 弹窗 Tabs */
.picker-tabs {
  display: flex;
  gap: 24rpx;
}

.picker-tab {
  font-size: 30rpx;
  color: #888;
  padding-bottom: 8rpx;
  position: relative;
  font-weight: 500;
}

.picker-tab.active {
  color: #0052D9;
  font-weight: 700;
}

.picker-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 10%;
  width: 80%;
  height: 4rpx;
  background: #0052D9;
  border-radius: 2rpx;
}

/* 城市选择面板 */
.city-picker-content {
  display: flex;
  flex-direction: column;
}

.city-search-box {
  display: flex;
  align-items: center;
  background: #F4F5F8;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.city-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #222;
}

.current-loc-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 16rpx;
}

.loc-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loc-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.relocate-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #0052D9;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ECF2FE;
}

/* 省市二级联动 */
.prov-city-cascade {
  display: flex;
  height: 480rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #FAFBFD;
}

.prov-col {
  width: 220rpx;
  height: 100%;
  background: #F3F4F7;
  border-right: 1rpx solid #EAECEF;
}

.prov-item {
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.prov-item.active {
  background: #FAFBFD;
  color: #0052D9;
  font-weight: 700;
  border-left: 6rpx solid #0052D9;
}

.city-col {
  flex: 1;
  height: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.city-item.active .c-name {
  color: #0052D9;
  font-weight: 700;
}

.c-name {
  font-size: 28rpx;
  color: #333;
}

/* 搜索结果 */
.search-result-list {
  height: 480rpx;
}

.search-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.res-city-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.res-prov-name {
  font-size: 22rpx;
  color: #999;
}

.search-empty {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
  text-align: center;
  padding: 0 40rpx;
}
