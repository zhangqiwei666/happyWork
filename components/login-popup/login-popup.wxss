/* components/login-popup/login-popup.wxss */
button::after {
  border: none;
}

.lp-mask,
.pv-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
}

.lp-mask {
  z-index: 9000;
  align-items: flex-end;
  animation: lp-fade 0.2s ease;
}

.pv-mask {
  z-index: 9100;
  align-items: center;
  justify-content: center;
  animation: lp-fade 0.2s ease;
}

.lp-sheet {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 64rpx 48rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: lp-up 0.25s ease;
}

.safe-area {
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.lp-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 12rpx;
}

.lp-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.lp-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #181818;
}

.lp-desc {
  font-size: 26rpx;
  color: #888;
  margin: 16rpx 0 56rpx;
  text-align: center;
}

.lp-btn {
  width: 100% !important;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
}

.lp-btn-primary {
  background: #07C160;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.lp-btn-primary[disabled] {
  background: #07C160 !important;
  color: #fff !important;
  opacity: 0.6;
}

.lp-btn-text {
  margin-left: 12rpx;
}

.lp-btn-hover {
  opacity: 0.8;
}

.lp-skip {
  font-size: 28rpx;
  color: #666;
  padding: 28rpx 0 12rpx;
}

.lp-agreement {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}

.lp-link {
  color: #0052D9;
}

/* 隐私弹窗 */
.pv-dialog {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
  animation: lp-zoom 0.2s ease;
}

.pv-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: #181818;
  margin-bottom: 28rpx;
}

.pv-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: #555;
}

.pv-sub {
  margin-top: 16rpx;
}

.pv-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 44rpx;
}

.pv-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 0;
  margin: 0;
}

.pv-btn-cancel {
  background: #F3F4F6;
  color: #666;
}

.pv-btn-agree {
  background: #07C160;
  color: #fff;
  font-weight: 600;
}

@keyframes lp-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes lp-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes lp-zoom {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

