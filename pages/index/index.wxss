/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 顶部动态氛围光晕 */
.ambient-glow {
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120%;
  height: 480rpx;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.7;
  z-index: 0;
  transition: all 0.6s ease;
  pointer-events: none;
}

/* 天气感知栏 */
.weather-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  padding: 24rpx 32rpx;
  border-radius: var(--td-radius-large);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  margin-bottom: 32rpx;
}

.weather-left {
  display: flex;
  align-items: center;
}

.weather-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}

.weather-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.weather-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.weather-temp {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.weather-desc {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.weather-switch-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.switch-tip {
  font-size: 24rpx;
  color: #888;
}

/* 区域标题 */
.section-header {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #777;
  margin-top: 6rpx;
}

/* 情绪网格选择 */
.mood-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.mood-item {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: var(--td-radius-medium);
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 3rpx solid transparent;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.mood-item.active {
  transform: translateY(-4rpx);
  background: #ffffff;
}

.mood-emoji {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.mood-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.mood-check-dot {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

/* 碎碎念输入区 */
.input-card {
  position: relative;
  z-index: 1;
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.input-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.quote-random-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.quote-preview {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.quote-symbol {
  font-size: 36rpx;
  line-height: 1;
  color: #888;
  font-family: Georgia, serif;
}

.quote-content {
  font-size: 26rpx;
  line-height: 1.5;
  color: #444;
  font-style: italic;
}

.textarea-wrap {
  margin-bottom: 28rpx;
  border: 1rpx solid #EEEEEE;
  border-radius: 16rpx;
  padding: 12rpx;
  background: #FAFAFC;
}

.action-btn-row {
  margin-top: 16rpx;
}

/* 生成后的情绪卡片展示区 */
.card-display-section {
  position: relative;
  z-index: 1;
  margin-top: 36rpx;
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.result-title-bar {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-badge {
  display: inline-block;
  background: #E8F3FF;
  color: #0052D9;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
}

.result-sub {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 精美卡片主体 */
.mood-card-preview {
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  position: relative;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.card-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.card-date-box {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.card-date-day {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  color: #222;
  font-family: 'Helvetica Neue', Arial, sans-serif;
}

.card-date-col {
  display: flex;
  flex-direction: column;
}

.card-date-ym {
  font-size: 24rpx;
  font-weight: 600;
  color: #444;
}

.card-date-week {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

.card-weather-tag {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(10rpx);
  padding: 10rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}

.card-mood-focus {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.card-mood-emoji {
  font-size: 80rpx;
}

.card-mood-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-mood-tagline {
  font-size: 24rpx;
  color: #555;
  margin-top: 6rpx;
}

.card-quote-box {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8rpx);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-quote-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2c2c2c;
  font-weight: 500;
}

.card-note-box {
  background: rgba(255, 255, 255, 0.55);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 28rpx;
}

.card-note-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.card-note-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #333;
}

.card-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(0, 0, 0, 0.1);
}

.card-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-author-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #444;
}

.card-logo-tag {
  font-size: 20rpx;
  color: #777;
  letter-spacing: 1rpx;
}

/* 操作功能四宫格 */
.card-actions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-btn-item {
  background: #FFFFFF;
  border-radius: var(--td-radius-large);
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* 清除 button 默认样式 */
.share-btn {
  margin: 0;
  line-height: normal;
  border: none;
  outline: none;
}
.share-btn::after {
  border: none;
}

.action-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.action-btn-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.action-btn-sub {
  font-size: 20rpx;
  color: #888;
  margin-top: 4rpx;
}

/* 天气选择器弹窗 */
.weather-picker-panel {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 60rpx;
  max-height: 70vh;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.weather-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.weather-option {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #F8F9FB;
  border: 2rpx solid transparent;
}

.weather-option.active {
  background: #ECF2FE;
  border-color: #0052D9;
}

.opt-emoji {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.opt-info {
  flex: 1;
}

.opt-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.opt-desc {
  font-size: 22rpx;
  color: #777;
  margin-top: 4rpx;
}

.hidden-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 900px;
}
