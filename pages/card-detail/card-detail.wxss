/* pages/card-detail/card-detail.wxss */
.detail-container {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  position: relative;
  box-sizing: border-box;
  background-color: var(--td-bg-color-page);
}

.ambient-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  filter: blur(80rpx);
  z-index: 0;
  pointer-events: none;
}

.card-wrap {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
}

.mood-card-preview {
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.author-text {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-time {
  font-size: 22rpx;
  color: #777;
  margin-top: 4rpx;
}

.weather-badge {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10rpx);
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}

.mood-core {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.mood-emoji {
  font-size: 80rpx;
}

.mood-info {
  flex: 1;
}

.mood-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a1a1a;
}

.mood-subtitle {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.quote-box {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(8rpx);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.quote-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #2a2a2a;
  font-style: italic;
  font-weight: 500;
}

.note-box {
  background: rgba(255, 255, 255, 0.5);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.note-title {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.note-content {
  font-size: 26rpx;
  line-height: 1.5;
  color: #222;
}

.card-footer {
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(0, 0, 0, 0.08);
  text-align: right;
}

.footer-tag {
  font-size: 20rpx;
  color: #888;
}

/* 快捷轻互动区 */
.reaction-section {
  position: relative;
  z-index: 1;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.title-tip {
  font-size: 22rpx;
  color: #888;
}

.reaction-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.reaction-btn {
  background: #F8F9FC;
  border-radius: 20rpx;
  padding: 20rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.reaction-btn.active {
  background: #E8F3FF;
  border-color: #0052D9;
}

.react-emoji {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.react-name {
  font-size: 22rpx;
  font-weight: 500;
  color: #444;
}

.react-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #0052D9;
  margin-top: 4rpx;
}

/* 留言板 */
.comment-section {
  position: relative;
  z-index: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.comment-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.comment-header-tip {
  font-size: 22rpx;
  color: #888;
}

.quick-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.quick-tag {
  background: #F4F5F9;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #555;
  border: 1rpx solid #E5E6EB;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F2F5;
}
.comment-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.comment-body {
  flex: 1;
}

.comment-user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-username {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
}

.comment-time {
  font-size: 20rpx;
  color: #999;
}

.comment-content {
  font-size: 26rpx;
  line-height: 1.5;
  color: #444;
  margin-top: 6rpx;
}

.empty-comment {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-emoji {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #999;
}

.bottom-go-home {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0052D9;
  background: #FFFFFF;
  border-radius: var(--td-radius-large);
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

/* 底部吸底输入条 */
.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-top: 1rpx solid #EAEAEA;
  padding: 16rpx 32rpx;
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.input-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 76rpx;
  background: #F5F6FA;
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #333;
}
